pReVYa3zoP","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"timestamp":"2025-10-29T19:00:00+0000","nextCase":{"id":"ZS51QREAACMhRRiz","type":"case","tags":["page"],"lang":"en-us","slug":"challenge","first_publication_date":"2023-10-17T12:34:14+0000","last_publication_date":"2025-10-29T19:12:41+0000","uid":"seejoy","url":"/work/seejoy","data":{"name":"SeeJoy","coverImage":{"dimensions":{"width":1000,"height":1600},"alt":"SeeJoy","copyright":null,"url":"https://images.prismic.io/catunic/798f3cff-cb14-4c64-b9bb-3a4dd012e53b_seejoy_main_screen.png?auto=format,compress","id":"ZU_dlBIAACEAleK3","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},"link_type":"Document","key":"73ed2db4-0ff1-481f-b060-654bbb1dbc5a","isBroken":false},"slices":[{"variation":"default","version":"initial","items":[],"primary":{"title":"Crea AI","subtitle":"An all-in-one AI application that will change \nthe way you generation, innovate, and collaborate."},"id":"case_page_top_block$bd959f3e-8863-4326-b212-1dcbda500f01","slice_type":"case_page_top_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"image":{"dimensions":{"width":1920,"height":1080},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRSLpReVYa3zoQ_creaai_screen.png?auto=format,compress","id":"aQJRSLpReVYa3zoQ","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"displayMode":"cover","parallaxMode":true,"spacingTop":"0","spacingBottom":"0"},"id":"single_image_block$d5e88104-c7f0-41d4-a1ab-dcad7ab49537","slice_type":"single_image_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"title":[{"type":"heading2","text":"Challenge","spans":[],"direction":"ltr"}],"titleSize":"3","text":[{"type":"paragraph","text":"Commencing the Crea AI project presented a significant challenge of reimagining a powerful AI marketplace application that had fallen behind modern UI standards. The core mission was to transform the application from a visually cluttered and unintuitive interface into a sleek, modern, and user-friendly platform. \n\nThe key objective was to enhance user satisfaction and engagement by creating a logical, streamlined experience that could compete with and surpass leading applications in the space, all while unifying a diverse set of AI tools under a single, sequential design.","spans":[],"direction":"ltr"}],"largeText":true,"spacingTop":"3","spacingBottom":"2"},"id":"intro_text_block$11460162-9f79-4cc2-a191-73472e00a8ff","slice_type":"intro_text_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"image":{"dimensions":{"width":1920,"height":1080},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRSbpReVYa3zoR_creaai.png?auto=format,compress","id":"aQJRSbpReVYa3zoR","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[{"type":"paragraph","text":"Whether you're an artist, content creator, marketer, or just a technology lover, Crea AI has everything you need. Modern tools turn your ideas into stunning visual art, dynamic animations and vivid experiences.","spans":[],"direction":"ltr"}],"displayMode":"auto","parallaxMode":true,"spacingTop":"1","spacingBottom":"1"},"id":"single_image_block$accbe86e-8416-4674-a95a-aa2de9849d48","slice_type":"single_image_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"image":{"dimensions":{"width":1920,"height":1080},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQNzYLpReVYa31wX_creaai1.png?auto=format,compress","id":"aQNzYLpReVYa31wX","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"displayMode":"auto","parallaxMode":true,"spacingTop":"0","spacingBottom":"1"},"id":"single_image_block$b65d2783-888b-4c4e-92fe-1de7f6d8eb01","slice_type":"single_image_block","slice_label":null},{"variation":"default","version":"initial","items":[{"image":{"dimensions":{"width":1000,"height":1000},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRTLpReVYa3zoT_creaai2.png?auto=format,compress","id":"aQJRTLpReVYa3zoT","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"square"},{"image":{"dimensions":{"width":1000,"height":1600},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRTrpReVYa3zoU_creaai3.png?auto=format,compress","id":"aQJRTrpReVYa3zoU","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"auto"},{"image":{"dimensions":{"width":1000,"height":1000},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRTrpReVYa3zoV_creaai4.png?auto=format,compress","id":"aQJRTrpReVYa3zoV","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"square"},{"image":{"dimensions":{"width":1000,"height":1600},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRT7pReVYa3zoW_creaai5.png?auto=format,compress","id":"aQJRT7pReVYa3zoW","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"auto"},{"image":{"dimensions":{"width":1000,"height":1600},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRULpReVYa3zoX_creaai6.png?auto=format,compress","id":"aQJRULpReVYa3zoX","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"auto"}],"primary":{"spacingTop":"2","spacingBottom":"2","size":"2"},"id":"image_grid_block$c2e4cdc2-47cd-45bb-a6f0-dccc2e4cee9c","slice_type":"image_grid_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"text":[{"type":"heading3","text":"Approach","spans":[],"direction":"ltr"},{"type":"paragraph","text":"The strategic approach centered on adopting and adapting the native iOS design language. This decision was pivotal in structuring a clean, familiar, and less crowded interface that prioritizes intuitive navigation. The process involved a complete overhaul of the component library, focusing on simplicity and clarity to ensure users could effortlessly access and utilize the vast array of image, video, and text generation tools. The foundation of the redesign was a revamped information architecture, engineered to guide the user naturally from discovering a model to generating and finally saving or sharing their masterpiece. Collaboration with developers ensured the new design system was implemented faithfully and efficiently.","spans":[],"direction":"ltr"}],"largeText":false,"animateHeadings":true,"position":"left","spacingTop":"1","spacingBottom":"2"},"id":"basic_text_block$94de2fce-37d2-4bfa-b40d-971fec8b0f30","slice_type":"basic_text_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"image":{"dimensions":{"width":1920,"height":1080},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRUbpReVYa3zoY_creaai10.png?auto=format,compress","id":"aQJRUbpReVYa3zoY","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"displayMode":"auto","parallaxMode":true,"spacingTop":"1","spacingBottom":"2"},"id":"single_image_block$0a8875c5-c14e-4d91-aba9-517e1672acb5","slice_type":"single_image_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"image":{"dimensions":{"width":1920,"height":1080},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQNzYLpReVYa31wY_creaai11.png?auto=format,compress","id":"aQNzYLpReVYa31wY","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"displayMode":"cover","parallaxMode":true,"spacingTop":"0","spacingBottom":"1"},"id":"single_image_block$d4f51717-af97-4fbb-ada5-d5ecd8dddc59","slice_type":"single_image_block","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"text":[{"type":"heading3","text":"Visuals and Design Principles","spans":[],"direction":"ltr"},{"type":"paragraph","text":"The visual design of Crea AI is guided by the principles of clarity, consistency, and brand identity. By embracing the iOS aesthetic, the interface achieves a native feel that reduces cognitive load and enhances usability. A refined color system introduces brand-accented elements for key actions like buttons and icons, strengthening visual identity and improving wayfinding. The layout leverages white space and simple components to create a calm, focused environment for creativity. Furthermore, the design fully supports both light and dark themes, maintaining brand color accents to ensure a comfortable and consistent user experience in any lighting condition.","spans":[],"direction":"ltr"}],"largeText":false,"animateHeadings":true,"position":"center","spacingTop":"2","spacingBottom":"2"},"id":"basic_text_block$c421c839-e6ff-4e2e-a233-a4868292191b","slice_type":"basic_text_block","slice_label":null},{"variation":"default","version":"initial","items":[{"image":{"dimensions":{"width":1000,"height":1600},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRU7pReVYa3zoa_creaai12.png?auto=format,compress","id":"aQJRU7pReVYa3zoa","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"auto"},{"image":{"dimensions":{"width":1000,"height":1000},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQNzYrpReVYa31wb_creaai13.png?auto=format,compress","id":"aQNzYrpReVYa31wb","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"square"},{"image":{"dimensions":{"width":1000,"height":1600},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQNzZbpReVYa31we_creaai14.png?auto=format,compress","id":"aQNzZbpReVYa31we","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"auto"},{"image":{"dimensions":{"width":1000,"height":1000},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRVrpReVYa3zod_creaai15.png?auto=format,compress","id":"aQJRVrpReVYa3zod","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"square"},{"image":{"dimensions":{"width":1000,"height":1000},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRVbpReVYa3zoc_creaai14.png?auto=format,compress","id":"aQJRVbpReVYa3zoc","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"square"},{"image":{"dimensions":{"width":1000,"height":1000},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQNzZ7pReVYa31wf_creaai16.png?auto=format,compress","id":"aQNzZ7pReVYa31wf","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"square"},{"image":{"dimensions":{"width":1000,"height":1000},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQNzZ7pReVYa31wg_creaai19.png?auto=format,compress","id":"aQNzZ7pReVYa31wg","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"square"},{"image":{"dimensions":{"width":1000,"height":1600},"alt":"Crea AI","copyright":null,"url":"https://images.prismic.io/catunic/aQJRX7pReVYa3zog_creaai18.png?auto=format,compress","id":"aQJRX7pReVYa3zog","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"caption":[],"captionAlign":"left","parallaxMode":true,"displayMode":"auto"}],"primary":{"spacingTop":"2","spacingBottom":"2","size":"2"},"id":"image_grid_block$6a50fc08-e274-